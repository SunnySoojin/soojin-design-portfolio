# Copy to `.env` (never commit `.env`).

# Base path for the site.
#  - Vercel / Netlify / custom domain: "/" (or leave empty)
#  - GitHub Pages project site: "/soojin-design-portfolio/"
VITE_BASE=/

# Canonical site URL used for SEO (Open Graph, canonical links).
VITE_SITE_URL=https://example.com

# Figma personal access token — ONLY for `npm run figma:export` (never shipped to the browser).
# Create at https://www.figma.com/settings → Security → Personal access tokens (File content: Read).
FIGMA_TOKEN=
